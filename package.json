{
  "name": "nous-wave-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx apps/nous-core/src/main.ts",
    "nous": "tsx scripts/nous.ts",
    "runtime:pack": "tsx scripts/pack-runtime.ts",
    "assemble:portable": "tsx scripts/assemble-portable.ts",
    "qualification:official-client": "tsx apps/nous-core/official_client_closure.ts",
    "qualification:memory-reference": "tsx apps/nous-core/qualification_memory_reference.ts",
    "qualification:cognitive-runtime-episode": "tsx apps/nous-core/qualification_cognitive_runtime_episode.ts",
    "qualification:real-consumer-local": "tsx apps/nous-cli/qualification-local.ts",
    "qualification:portable-local": "tsx apps/nous-cli/qualification-portable.ts",
    "format": "prettier \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,js,cjs,mjs,yml,yaml}\" --write",
    "format:check": "prettier \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,js,cjs,mjs,yml,yaml}\" --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "buf generate",
    "proto:check": "buf lint",
    "lint:ts": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:knip": "knip --strict",
    "lint:deps": "dependency-cruiser apps/nous-core/src packages --config .dependency-cruiser.cjs",
    "lint:dupes": "jscpd .",
    "lint:sherif": "sherif",
    "quality": "pnpm lint:knip && pnpm lint:deps && pnpm lint:sherif",
    "check:governance": "pnpm format:check && pnpm lint:ts && pnpm quality",
    "check": "pnpm proto:check && pnpm typecheck && pnpm test && pnpm check:governance",
    "research:retrieval-live": "tsx apps/nous-cli/research-live.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.3",
    "@types/yauzl": "2.10.3",
    "dependency-cruiser": "18.4.0",
    "esbuild": "0.28.2",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "sherif": "1.13.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
