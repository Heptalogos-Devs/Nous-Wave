{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/dev.ts"] },
    "apps/nous-cli": { "entry": ["src/main.ts!", "qualification-local.ts"] }
  },
  "ignore": [
    "apps/nous-core/official_client_closure.ts",
    "apps/nous-core/qualification_memory_reference.ts",
    "apps/nous-core/qualification_cognitive_runtime_episode.ts",
    "apps/nous-core/research_retrieval.ts"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  },
  "ignoreBinaries": ["tsx"]
}
