{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev.ts",
        "scripts/nous.ts",
        "scripts/pack-runtime.ts",
        "scripts/assemble-portable.ts"
      ]
    },
    "apps/nous-core": {
      "entry": ["src/main.ts!", "src/launcher.ts!"]
    },
    "apps/nous-cli": {
      "entry": [
        "src/main.ts!",
        "qualification-local.ts",
        "qualification-portable.ts",
        "research-live.ts",
        "qualification-live.ts"
      ]
    }
  },
  "ignore": [
    "apps/nous-core/official_client_closure.ts",
    "apps/nous-core/qualification-config.ts",
    "apps/nous-core/qualification_memory_reference.ts",
    "apps/nous-core/qualification_cognitive_runtime_episode.ts"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  },
  "ignoreBinaries": ["tsx"]
}
