{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "apps/nous-core/**/*.ts",
    "apps/nous-cli/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts"
  ]
}
