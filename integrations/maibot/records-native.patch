@@ -0,0 +1,223 @@
+"""现有记忆记录页面的数据投影；记录、来源和历史由 Nous SDK 读取。"""
+
+from typing import Any, Dict, List
+
+from nous_sdk.amemorix import AMemorixAdapter
+from nous_sdk.contracts import (
+    AssociationBody,
+    EntityBody,
+    EpisodeBody,
+    MemoryBody,
+    RecordsQuery,
+)
+from nous_sdk.contracts.fact_body import FactClaimBody
+from nous_sdk.contracts.records import RecordEntry
+from nous_sdk.presentation import object_text
+
+KINDS = {
+    "paragraph": "memory",
+    "entity": "entity",
+    "relation": "association",
+    "fact": "fact_claim",
+    "episode": "episode",
+}
+TYPES = {value: key for key, value in KINDS.items()}
+GROUPS = {
+    "paragraph": "paragraphs",
+    "entity": "entities",
+    "relation": "relations",
+    "fact": "facts",
+    "episode": "episodes",
+}
+
+
+def seconds(point) -> float | None:
+    return point.coordinate / 1000 if point is not None and point.domain == "unix_ms" else None
+
+
+def payload(entry: RecordEntry, source_names: Dict[str, str], labels: Dict[str, str]) -> Dict[str, Any]:
+    record, body = entry.record, entry.record.body
+    text = object_text(record)
+    kind = TYPES[record.reference.kind]
+    source = ", ".join(dict.fromkeys(source_names[root] for root in record.source_roots if root in source_names))
+    metadata: Dict[str, Any] = {
+        "reference": record.reference.model_dump(mode="json"),
+        "source_roots": list(record.source_roots),
+    }
+    title = text.splitlines()[0][:88] if text else record.reference.exact()
+    if isinstance(body, MemoryBody):
+        title = body.summary or body.text[:88]
+        metadata.update(knowledge_type=body.role, raw=body.metadata)
+    elif isinstance(body, EntityBody):
+        title = body.label
+        metadata.update(
+            name=body.label,
+            aliases=list(body.effective_aliases),
+            active_evidence_count=sum(link.polarity == "support" for link in record.evidence),
+            raw=body.model_dump(mode="json"),
+        )
+    elif isinstance(body, AssociationBody):
+        subject = labels.get(body.from_ref.id, body.from_ref.exact())
+        target = labels.get(body.to_ref.id, body.to_ref.exact())
+        title = f"{subject} {body.relation} {target}"
+        metadata.update(
+            subject=subject,
+            predicate=body.relation,
+            object=target,
+            confidence=body.epistemic.confidence,
+            weight=body.weight,
+            raw=body.model_dump(mode="json"),
+        )
+    elif isinstance(body, FactClaimBody):
+        title = body.value_text
+        metadata.update(
+            scope_type=body.scope.kind,
+            scope_id=body.scope.identity,
+            fact_key=body.fact_key,
+            value_text=body.value_text,
+            confidence=body.confidence,
+            polarity=body.polarity,
+            raw=body.model_dump(mode="json"),
+        )
+    elif isinstance(body, EpisodeBody):
+        title = body.title
+        metadata.update(paragraph_count=len(body.members), raw=body.model_dump(mode="json"))
+    return {
+        "type": kind,
+        "id": record.reference.id,
+        "title": title,
+        "summary": text[:240],
+        "source": source,
+        "source_label": source,
+        "status": entry.state,
+        "created_at": seconds(record.times.formation),
+        "updated_at": seconds(record.times.recorded),
+        "metadata": metadata,
+    }
+
+
+class NousRecordViews:
+    def __init__(self, adapter: AMemorixAdapter) -> None:
+        self.adapter = adapter
+        self.client = adapter.client
+        self.namespace_id, self.subject_id = adapter.namespace_id, adapter.subject_id
+
+    async def source_names(self) -> Dict[str, str]:
+        sources = await self.client.source_directory(self.namespace_id, self.subject_id)
+        return {source.id: source.source or source.source_type for source in sources}
+
+    async def search(self, query: str, *, record_types: str, limit: int, include_inactive: bool) -> Dict[str, Any]:
+        selected = [name.strip() for name in record_types.split(",") if name.strip()] or list(KINDS)
+        unknown = set(selected).difference(KINDS)
+        if unknown:
+            raise ValueError(f"不支持的记忆类型: {', '.join(sorted(unknown))}")
+        kinds = tuple(KINDS[name] for name in selected)
+        page = await self.client.records(
+            self.namespace_id,
+            self.subject_id,
+            RecordsQuery.model_validate(
+                {
+                    "kinds": kinds,
+                    "text": query.strip() or None,
+                    "limit": limit,
+                    "purpose": "management" if include_inactive else "current",
+                }
+            ),
+        )
+        labels = {
+            item.record.reference.id: item.record.body.label
+            for item in page.items
+            if isinstance(item.record.body, EntityBody)
+        }
+        sources = await self.source_names()
+        items = [payload(item, sources, labels) for item in page.items]
+        return {
+            "success": True,
+            "query": query,
+            "types": selected,
+            "include_inactive": include_inactive,
+            "limit": limit,
+            "count": len(items),
+            "counts": {name: sum(item["type"] == name for item in items) for name in selected},
+            "items": items,
+            "next_cursor": page.next_cursor,
+            "coverage": page.coverage.model_dump(mode="json"),
+        }
+
+    async def detail(self, record_type: str, record_id: str, limit: int) -> Dict[str, Any]:
+        if record_type not in KINDS:
+            raise ValueError(f"不支持的记忆类型: {record_type}")
+        resolved = await self.client.resolve_reference(self.subject_id, f"{KINDS[record_type]}:{record_id}")
+        if resolved.reference.kind != "cognition":
+            raise ValueError("记录详情需要认知引用")
+        detail = await self.client.record_detail(
+            self.namespace_id, self.subject_id, resolved.reference.reference, history_limit=limit, purpose="management"
+        )
+        record = detail.entry.record
+        if record.source_roots:
+            related_page = await self.client.records(
+                self.namespace_id,
+                self.subject_id,
+                RecordsQuery.model_validate(
+                    {
+                        "kinds": tuple(KINDS.values()),
+                        "source_ids": record.source_roots,
+                        "limit": limit,
+                        "as_of_commit": detail.history.coverage.snapshot_commit,
+                    }
+                ),
+            )
+            entries = related_page.items
+        else:
+            entries = ()
+        labels = {
+            item.record.reference.id: item.record.body.label
+            for item in entries
+            if isinstance(item.record.body, EntityBody)
+        }
+        sources = await self.source_names()
+        related: Dict[str, List[Dict[str, Any]]] = {group: [] for group in (*GROUPS.values(), "profiles")}
+        for item in entries:
+            related[GROUPS[TYPES[item.record.reference.kind]]].append(payload(item, sources, labels))
+        evidence: List[Dict[str, Any]] = []
+        if isinstance(record.body, FactClaimBody):
+            for item in record.body.evidence:
+                link = item.link
+                evidence.append(
+                    {
+                        "evidence_type": "paragraph"
+                        if link.reference and link.reference.kind == "memory"
+                        else "manual",
+                        "evidence_id": link.reference.exact() if link.reference else link.observation_id,
+                        "stance": "refute" if link.polarity == "counter" else "support",
+                    }
+                )
+        transitions = [
+            {
+                "transition_id": item.record.reference.exact(),
+                "transition_type": item.record.cause.action if item.record.cause else "formation",
+                "reason": item.record.cause.reason if item.record.cause else "",
+                "created_at": seconds(item.record.times.recorded),
+            }
+            for item in detail.history.items
+        ]
+        actions = {
+            "paragraph": ["graph", "correct", "delete"],
+            "entity": ["graph", "delete"],
+            "relation": ["graph", "delete"],
+            "episode": ["graph"],
+            "fact": ["restore_fact", "profile"]
+            if isinstance(record.body, FactClaimBody) and record.body.status in {"retracted", "superseded"}
+            else ["edit_fact", "retract_fact", "profile"],
+        }[record_type]
+        return {
+            "success": True,
+            "record": payload(detail.entry, sources, labels),
+            "related": related,
+            "counts": {key: len(values) for key, values in related.items()},
+            "fact_evidence": evidence,
+            "fact_transitions": transitions if record_type == "fact" else [],
+            "projection": {"graph_jobs": [], "graph_pending_count": 0},
+            "available_actions": actions,
+            "history": detail.history.model_dump(mode="json"),
+        }
