{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev/*.ts!",
        "scripts/runtime/pack.ts!",
        "scripts/release/{assemble,archive,prepare-notices,verify-portable}.ts!",
        "scripts/smoke/{memory,runtime-episode,model-material-resource,longitudinal,configuration}.ts!",
        "scripts/research/{retrieval,media,serve-gateway,longitudinal,model-contracts,model-trace}.ts!",
        "scripts/research/*.test.ts"
      ]
    },
    "apps/nous-core": {
      "entry": [
        "src/main.ts!",
        "src/launcher.ts!",
        "src/**/*.test.ts",
        "tests/*.test.ts"
      ],
      "ignoreExportsUsedInFile": {
        "class": true,
        "function": true
      }
    },
    "apps/nous-cli": {
      "entry": ["src/main.ts!"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  },
  "ignoreBinaries": ["tsx"]
}
