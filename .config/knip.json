{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev/start.ts",
        "scripts/dev/nous.ts",
        "scripts/runtime/pack.ts",
        "scripts/dev/prepare.ts",
        "scripts/release/*.ts",
        "scripts/smoke/*.ts",
        "scripts/research/*.ts",
        "scripts/research/serve-gateway.ts!"
      ]
    },
    "apps/nous-core": {
      "entry": ["src/main.ts!", "src/launcher.ts!"]
    },
    "apps/nous-cli": {
      "entry": ["src/main.ts!"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  },
  "ignoreBinaries": ["tsx"]
}
